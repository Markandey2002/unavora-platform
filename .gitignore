# Secrets and local environment (never commit real values)
.env
.env.*
!.env.example
!.env.*.example

# Node / Next.js
node_modules/
.next/
out/
coverage/
playwright-report/
test-results/
*.tsbuildinfo

# Java / Maven
target/
*.class
.mvn/wrapper/maven-wrapper.jar

# IDEs / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Terraform (infrastructure code comes later; never commit state)
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example

# Local data volumes
.data/

# Isolation guard (root package.json) must never get a lockfile or deps
/package-lock.json
/node_modules/

# Crash / diagnostic output (JVM, npm, Python)
hs_err_pid*.log
replay_pid*.log
*.log
__pycache__/
*.py[cod]

# Generated by Next.js on every build/dev run
next-env.d.ts

# Keys, certificates and provider credential files (Google OAuth client secrets, service accounts, keystores)
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
client_secret*.json
credentials*.json
service-account*.json
*-sa.json

# Database dumps, backups and any local data exports (may contain personal data)
*.dump
*.backup
*.bak
*.sql.gz
/exports/
/backups/

# Local tool settings
.claude/settings.local.json

# Private uploads (owner submission photos) written by the local API: never commit
services/api/data/
