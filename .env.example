# Copy to .env for Docker Compose overrides. All values here are LOCAL DEVELOPMENT ONLY.
# Never put staging or production credentials in any file in this repository.

POSTGRES_DB=unavora
POSTGRES_USER=unavora_local
POSTGRES_PASSWORD=unavora_local_dev_only

MINIO_ROOT_USER=minio_local
MINIO_ROOT_PASSWORD=minio_local_dev_only

KEYCLOAK_ADMIN=admin_local
KEYCLOAK_ADMIN_PASSWORD=admin_local_dev_only
