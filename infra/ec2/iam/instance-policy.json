{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PullUnavoraImages",
      "Effect": "Allow",
      "Action": ["ecr:BatchCheckLayerAvailability", "ecr:BatchGetImage", "ecr:GetDownloadUrlForLayer"],
      "Resource": [
        "arn:aws:ecr:REGION:ACCOUNT_ID:repository/unavora-api",
        "arn:aws:ecr:REGION:ACCOUNT_ID:repository/unavora-web",
        "arn:aws:ecr:REGION:ACCOUNT_ID:repository/unavora-edge"
      ]
    },
    {
      "Sid": "EcrLogin",
      "Effect": "Allow",
      "Action": "ecr:GetAuthorizationToken",
      "Resource": "*"
    },
    {
      "Sid": "ReadOwnEnvironmentSettingsOnly",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParametersByPath"],
      "Resource": [
        "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/unavora/ENVIRONMENT",
        "arn:aws:ssm:REGION:ACCOUNT_ID:parameter/unavora/ENVIRONMENT/*"
      ]
    },
    {
      "Sid": "DecryptSecureStringParameters",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:REGION:ACCOUNT_ID:key/KMS_KEY_ID",
      "Condition": { "StringEquals": { "kms:ViaService": "ssm.REGION.amazonaws.com" } }
    }
  ]
}
